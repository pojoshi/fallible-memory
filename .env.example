# Copy to .env. Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
TOMBSTONE_KEY=replace-me-with-a-long-random-string
# hashing (default, offline) | hashing:512 | st:sentence-transformers/all-MiniLM-L6-v2 (needs the [ml] extra)
EMBEDDER=hashing
# Only used outside docker compose:
# DATABASE_URL=postgresql://fallible:fallible@localhost:5432/fallible
# MATCH_THRESHOLD=0.70
# UNCERTAIN_THRESHOLD=0.55
